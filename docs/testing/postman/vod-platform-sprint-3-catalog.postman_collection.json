            "v1",
            "movies"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{title2}}\",\n  \"slug\": \"{{slug2}}\",\n  \"description\": \"Newman Sprint 3 catalog fixture.\",\n  \"releaseYear\": 2024,\n  \"maturityRating\": \"T13\",\n  \"genres\": [\n    \"{{genreName}}\"\n  ],\n  \"people\": [\n    {\n      \"personId\": \"{{personId}}\",\n      \"role\": \"DIRECTOR\"\n    }\n  ],\n  \"status\": \"DRAFT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
