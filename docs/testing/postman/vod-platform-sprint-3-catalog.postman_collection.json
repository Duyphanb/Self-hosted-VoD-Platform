{
  "info": {
    "_postman_id": "6a3f2c1e-9b4d-4e8a-8c2f-3d1e0b9a7c55",
    "name": "VoD Platform - Sprint 3 Catalog",
    "description": "Sprint 3 catalog checks through Nginx: admin CRUD for genres, people and movies, visibility 404s, regular-user 403s, pagination and Vietnamese title order. Needs adminEmail/adminPassword for an account promoted with the documented SQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Sign in as the administrator",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString(36) + pm.variables.replaceIn('{{$randomInt}}');",
              "pm.environment.set('catalogSuffix', suffix);",
              "pm.environment.set('testEmail', 'newman-catalog-' + suffix + '@example.com');",
              "pm.environment.set('genreName', 'Newman Thể Loại ' + suffix);",
              "pm.environment.set('personName', 'Newman Đạo Diễn ' + suffix);",
              "['Ánh Sáng', 'Avatar', 'Đất Rừng Phương Nam', 'Zootopia'].forEach((title, index) => {",
              "  pm.environment.set('title' + index, title + ' Newman ' + suffix);",
              "  pm.environment.set('slug' + index, 'newman-' + index + '-' + suffix);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Administrator session includes ROLE_ADMIN', () => {",
              "  pm.expect(body.user.roles).to.include('ROLE_ADMIN');",
              "});",
              "pm.environment.set('adminAccessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
