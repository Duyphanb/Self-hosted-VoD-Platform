    {
      "name": "13 - Create a draft movie with a genre and a director",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Movie is a draft with its genre and director', () => {",
              "  pm.expect(body.status).to.equal('DRAFT');",
              "  pm.expect(body.genres).to.deep.equal([pm.environment.get('genreName')]);",
              "  pm.expect(body.people[0].personId).to.equal(pm.environment.get('personId'));",
              "  pm.expect(body.people[0].role).to.equal('DIRECTOR');",
              "});",
              "pm.environment.set('movieId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
