{
  "info": {
    "_postman_id": "7c2e4a19-3f5d-4b6e-9a8c-1d2e3f4a5b6c",
    "name": "VoD Platform - Sprint 4 Upload",
    "description": "Sprint 4 admin upload checks through Nginx: 401/403 before parsing, 400 unsupported type, 404 missing movie, 409 in-flight asset, backend 413 ApiError and 202 QUEUED, each error with a requestId. Needs adminEmail/adminPassword (an administrator promoted with the documented SQL), uploadMovieId/inFlightMovieId and the files from deploy/tests/newman-upload-fixtures.py (run Newman with --working-dir pointing at them) and a backend started with MAX_UPLOAD_SIZE_MB=1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Sign in as the administrator",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString(36) + pm.variables.replaceIn('{{$randomInt}}');",
              "pm.environment.set('testEmail', 'newman-upload-' + suffix + '@example.com');",
              "pm.environment.set('missingMovieId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Administrator session includes ROLE_ADMIN', () => {",
              "  pm.expect(body.user.roles).to.include('ROLE_ADMIN');",
              "});",
              "pm.environment.set('adminAccessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
