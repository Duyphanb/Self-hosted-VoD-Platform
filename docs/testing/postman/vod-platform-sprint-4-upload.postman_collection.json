    {
      "name": "10 - Accept a valid upload as QUEUED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 202', () => {",
              "  pm.response.to.have.status(202);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Accepted asset is QUEUED without internal keys', () => {",
              "  pm.expect(body.status).to.equal('QUEUED');",
              "  pm.expect(body.videoAssetId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
              "  pm.expect(body).to.not.have.property('requestId');",
              "  pm.expect(pm.response.text()).to.not.include('vod-raw');",
              "});"
            ]
          }
        }
