    {
      "name": "04 - Reject an anonymous upload before parsing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', () => {",
              "  pm.response.to.have.status(401);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('ApiError UNAUTHORIZED with a safe requestId', () => {",
              "  pm.expect(body.status).to.equal(401);",
              "  pm.expect(body.code).to.equal('UNAUTHORIZED');",
              "  pm.expect(body.timestamp).to.be.a('string');",
              "  pm.expect(body.message).to.be.a('string');",
              "  pm.expect(body.requestId).to.match(/^[A-Za-z0-9._-]{1,64}$/);",
              "});",
              "pm.test('No storage internals in the body', () => {",
              "  pm.expect(pm.response.text()).to.not.include('vod-raw');",
              "  pm.expect(pm.response.text()).to.not.include('Exception');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/movies/{{uploadMovieId}}/video",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "movies",
            "{{uploadMovieId}}",
            "video"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "valid.mp4",
              "contentType": "video/mp4"
            }
          ]
        }
      }
    },
