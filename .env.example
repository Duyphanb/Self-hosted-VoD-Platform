# Local development template only. Production rejects the published credential placeholders below.

# App
APP_ENV=local
APP_BASE_URL=http://localhost
COMPOSE_PROJECT_NAME=vod-platform

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_HLS_BASE_URL=/hls

# Backend API
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-me-use-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vod_platform
# Bootstrap superuser (legacy default name): server bootstrap, postgres-init and
# operator maintenance only; never supplied to applications.
POSTGRES_USER=vod_app
POSTGRES_PASSWORD=change-me
# Least-privilege roles provisioned by postgres-init (#106): Flyway migrates as the
# schema owner, the backend has DML only, the worker reads/updates encoding rows only.
# Role names: lowercase letters, digits and _, not starting with pg_.
POSTGRES_OWNER_USER=vod_owner
POSTGRES_OWNER_PASSWORD=change-me-db-owner
POSTGRES_BACKEND_USER=vod_backend
POSTGRES_BACKEND_PASSWORD=change-me-db-backend
POSTGRES_WORKER_USER=vod_worker
POSTGRES_WORKER_PASSWORD=change-me-db-worker
# Backend and worker derive SPRING_DATASOURCE_URL from POSTGRES_HOST/PORT/DB, like
# Flyway. Set it only as a local override; production rejects a URL that differs.

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# Required by the Redis server; only the backend receives it. No whitespace or quotes.
REDIS_PASSWORD=change-me-redis

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Bootstrap administrator: broker definitions and operator maintenance only.
RABBITMQ_USERNAME=vod_app
RABBITMQ_PASSWORD=change-me
# Non-administrator application users limited to the encoding queue topology (#106).
RABBITMQ_BACKEND_USERNAME=vod_backend
RABBITMQ_BACKEND_PASSWORD=change-me-mq-backend
RABBITMQ_WORKER_USERNAME=vod_worker
RABBITMQ_WORKER_PASSWORD=change-me-mq-worker
RABBITMQ_ENCODING_QUEUE=video-encoding-queue
ENCODING_PUBLISH_CONFIRM_TIMEOUT_MS=5000
ENCODING_RELAY_INTERVAL_SECONDS=10

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_CONNECT_TIMEOUT_MS=10000
MINIO_READ_TIMEOUT_MS=60000
MINIO_WRITE_TIMEOUT_MS=60000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Root: server and init only; never supplied to backend/worker.
MINIO_ACCESS_KEY=vod_minio
MINIO_SECRET_KEY=change-me
# Independent scoped application identities (replace all in production).
MINIO_BACKEND_ACCESS_KEY=vod_backend
MINIO_BACKEND_SECRET_KEY=change-me-backend-only
MINIO_WORKER_ACCESS_KEY=vod_worker
MINIO_WORKER_SECRET_KEY=change-me-worker-only
MINIO_BUCKET_RAW=vod-raw
MINIO_BUCKET_HLS=vod-hls
MINIO_BUCKET_THUMBNAILS=vod-thumbnails

# Uploads
# MiB: must equal the frozen Nginx upload literal and SPA constant (2048).
# Production preflight rejects drift; coordinate every layer before changing it.
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/x-matroska,video/webm,video/quicktime
TEMP_UPLOAD_DIR=/tmp/vod-uploads

# Worker
WORKER_CONCURRENCY=1
WORKER_PREFETCH=1
# Worker PostgreSQL driver and per-statement budgets
WORKER_JDBC_CONNECT_TIMEOUT_SECONDS=5
WORKER_JDBC_READ_TIMEOUT_SECONDS=10
WORKER_JDBC_STATEMENT_TIMEOUT_MS=5000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_SEGMENT_SECONDS=6
HLS_TARGET_HEIGHT=720
WORKER_TEMP_DIR=/tmp/vod-worker

# Nginx / deployment
# Loopback only. LAN access requires a non-placeholder JWT_SECRET; see README.md.
# Production must set NGINX_HTTP_PORT=80 explicitly.
NGINX_HTTP_PORT=127.0.0.1:80
NGINX_HTTPS_PORT=443
PUBLIC_DOMAIN=localhost
LETSENCRYPT_EMAIL=change-me@example.com

# Optional later AWS extension
AWS_REGION=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
