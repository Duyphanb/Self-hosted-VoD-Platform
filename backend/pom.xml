<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.vodplatform</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>vod-backend</name>

    <modules>
        <module>shared</module>
        <module>auth</module>
        <module>user</module>
        <module>catalog</module>
        <module>upload</module>
        <module>encoding</module>
        <module>playback</module>
        <module>stream</module>
        <module>progress</module>
        <module>library</module>
        <module>search</module>
        <module>common</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Boot 4.1.1 manages amqp-client 5.30.0 (HIGH: CVE-2026-63337/69219/69220/75516; all fixed by 5.34.0). -->
        <rabbit-amqp-client.version>5.37.0</rabbit-amqp-client.version>
        <!-- Boot 4.1.1 manages Tomcat 11.0.24 (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525; fixed in 11.0.25). -->
        <tomcat.version>11.0.27</tomcat.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Boot 4.1.1 manages Jackson 3.1.5 (HIGH: CVE-2026-89407, CVE-2026-89425, CVE-2026-68497, CVE-2026-91776, CVE-2026-91777; fixed in 3.1.7). -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!-- MinIO uses Jackson 2: Boot 4.1.1's 2.21.5 has CVE-2026-89407/89425/68497/91776/91777. -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- MinIO's Guava 33.6.0-jre has CVE-2026-102554; fixed in 33.7.2-jre. -->
        <guava.version>33.7.2-jre</guava.version>
        <!-- SDK class verification needs Snappy even without Snowball; 1.1.10.8 has CVE-2026-93451/108106. -->
        <snappy-java.version>1.1.10.9</snappy-java.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
