<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.vodplatform</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>vod-backend</name>

    <modules>
        <module>auth</module>
        <module>user</module>
        <module>catalog</module>
        <module>upload</module>
        <module>encoding</module>
        <module>playback</module>
        <module>stream</module>
        <module>progress</module>
        <module>library</module>
        <module>search</module>
        <module>common</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Boot 4.1.1 manages Tomcat 11.0.24 (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525; fixed in 11.0.25). -->
        <tomcat.version>11.0.27</tomcat.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Boot 4.1.1 manages Jackson 3.1.5 (HIGH: CVE-2026-89407, CVE-2026-89425, CVE-2026-68497, CVE-2026-91776, CVE-2026-91777; fixed in 3.1.7). -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
    </properties>
</project>
